# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/

# Models (large, download via setup wizard) — anything not in the
# small CP3 fine-tunes that ship with the repo.
data/models/*.pkl
data/models/*.pth
data/models/cellpose_*
data/models/rf_*
data/models/filter_config.json
data/models/sam/
data/models/sam2/
data/models/deepsea/segmentation.pth
data/models/deepsea/tracker.pth
data/models/medsam_*
# The cpsam_dic ViT fine-tune is ~1.1 GB — exceeds GitHub's 100 MB
# file limit. Users download it separately via `download_models.py`.
data/models/cpsam_dic
data/models/cpsam_dic_*

# Example recordings (large, user-provided)
data/examples/**/*.tif
data/examples/**/*.tiff
data/examples/**/*.mp4
data/examples/**/*.avi

# Exception: the small multichannel test fixture (7.4 MB) ships with
# the repo so the lab-install validation + remote-control RPC smoke
# test have a working multichannel recording on a fresh clone.
!data/examples/test_small_multichannel/test_small_multichannel.ome.tif

# Exception: the single-cell crop (8.6 MB) is the default recording for
# scripts/test_focused_gui.py — ships so the focused-GUI test runs on a
# fresh clone. Generated by scripts/make_single_cell_example.py from a
# reviewed IC295 mask stack (its _masks.npz + .json ship too, as GT).
!data/examples/single_cell_crop_wt/single_cell_crop_wt.tif

# Debug / problem-frame screenshots accumulated under example dirs
# during ad-hoc diagnosis sessions.
data/examples/**/cell*_problem.png
data/examples/**/cell*_zoom.png
data/examples/**/debug_*.png

# Generated analysis output in example folders (mirrors top-level
# results/ exclusion). Keep the recording + sidecar JSON + .cellscope
# project file, drop computed masks/metrics/diagnostics.
data/examples/**/results/

# Results (generated) — exclude everything UNDER results/ except
# the demo / smoke-test outputs that ship with the repo (small
# PNGs/JSONs used by docs and the README). We don't blanket-exclude
# results/ itself because git can't re-include children of an
# excluded directory.
results/*
!results/gui_smoke/
!results/best_detections/
!results/dic_model_eval/
!results/divisions/
# figure_pipelines/ contains 25-60 MB .npz arrays — exclude even
# though it ships with the repo. Users can regenerate via scripts.
results/figure_pipelines/*.npz

# GT tarball backups (redundant — live GT is in data/ic295_gt_full/)
data/gt_backups/

# gt_review/ — local aggregation of recordings + drive masks (symlinks)
# + moved eval reports, for viewing/analysis in CellScope. Full of
# drive symlinks that don't resolve elsewhere; never ship to git.
gt_review/

# GT audit subdirs — frozen snapshots of `pipeline_results/` from
# prior pipeline iterations (method_d_attempt, pre_mirror_pad,
# pre_persistence_guard, old_cpsam_dic, padded_v1, etc.). Useful
# locally as scientific provenance; never ship to git. The canonical
# current run is `pipeline_results/` (no suffix).
data/ic295_gt_full/**/pipeline_results_*/
data/legacy_gt/**/pipeline_results_*/

# GT mask backups saved alongside the canonical masks.npz when a
# pipeline default changes (e.g. masks_pre_v2.npz next to masks.npz).
data/ic295_gt_full/**/masks_pre_*.npz
data/legacy_gt/**/masks_pre_*.npz
data/ic295_gt_full/**/*_pre_v2.npz
data/legacy_gt/**/*_pre_v2.npz

# Top-level convenience symlinks to the external drive (resolve only
# on the maintainer's machine; broken on any other clone).
/fiji_export_test
/results

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Conda/venv
.conda/
.venv/
venv/

# Claude Code
.claude/

# Distribution
*.zip
cellscope_*.tar.gz

# ic295_analysis/ — long-running batch analysis + treatment-comparison
# outputs. Symlinks to drive masks + computed CSVs/JSONs/plots; local
# to whichever machine is running the batch, never ship to git.
# Use the contents-glob (not the bare dir) so the README re-include
# below actually fires — git can't un-ignore files under an ignored dir.
ic295_analysis/*
# Keep the README — it's the usage doc for the batch scripts.
!ic295_analysis/README.md

# ic293_analysis/ — staged single-cell crops from the IC293 dataset
# (Ignasi's hand-cropped cells) converted to the IC295 file format,
# plus future detection/analysis outputs. 3.2 GB of microscopy data +
# derived results — local only, never ship to git. Same contents-glob
# pattern as ic295_analysis so the README/provenance docs re-include.
ic293_analysis/*
!ic293_analysis/README.md
!ic293_analysis/PROVENANCE.md
# Human method-decision log (small, reproducibility record — ship it;
# the generated CURATION_REPORT.md / review/ stay ignored as regenerable).
!ic293_analysis/CURATION_DECISIONS.md

# ic295_single-cell-crop_analysis/ — DERIVED single-cell crops cut out of the
# multi-cell IC295 recordings (cropped videos + isolated masks + per-cell
# analysis + comparison plots). GBs of microscopy data, derived locally from
# ic295_analysis; never ship to git (public repo). Keep only the README.
ic295_single-cell-crop_analysis/*
!ic295_single-cell-crop_analysis/README.md

# Comprehensive internal lab report — its figures are ACTUAL microscopy
# screenshots (DIC frames, single-cell crops). This repo is PUBLIC and no
# real microscopy data may ship, so keep the report + its figure folder
# out of git. Shared with the lab out-of-band, not via GitHub.
docs/CELLSCOPE_REPORT.md
docs/report_figures/
